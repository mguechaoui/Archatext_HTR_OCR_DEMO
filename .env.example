# Copy to `.env` and adjust for your environment.
# All variables are prefixed OCR_ and map onto app/config/settings.py.

OCR_DEBUG=false

# Device: "auto" picks cuda > mps > cpu automatically. Force "cpu" in any
# container deployment — "auto" is fine, but being explicit means a config
# mistake fails at startup rather than silently running 10x slower.
OCR_DEVICE=auto

# --- Model artifacts ------------------------------------------------------
# Root directory for all weights. Every checkpoint path below defaults to a
# location under it, so in most deployments this is the only path you set.
#   container: /models  |  local: ./model_weights
OCR_MODEL_DIR=./model_weights

# Azure Blob Storage source for scripts/fetch_models.py. Leave BASE_URL empty
# to skip the fetch and use whatever is already on disk.
OCR_MODEL_BASE_URL=
OCR_MODEL_SAS_TOKEN=
OCR_MODEL_VERSION=v1
# Set to 1 for local dev with bind-mounted weights.
OCR_SKIP_MODEL_FETCH=0

# --- Explicit checkpoint overrides (optional) -----------------------------
# Only needed if your layout differs from the manifest's `dest` paths.
# OCR_SEGMENTATION_MODEL_PATH=./model_weights/seg/muharaf_seg_best.mlmodel
# OCR_MYOCR_CHECKPOINT_PATH=./model_weights/ocr/arman_best.mlmodel
# OCR_HATFORMER_CHECKPOINT_PATH=./model_weights/ocr/hatformer
OCR_SEGMENTATION_TEXT_DIRECTION=horizontal-rl

# --- Engine selection -----------------------------------------------------
# "*" for all, or a comma-separated subset. The memory lever: HATFormer alone
# costs well over a gigabyte of RSS.
OCR_ENABLED_OCR_ENGINES=*
OCR_EAGER_LOAD_MODELS=true

# --- Performance ----------------------------------------------------------
OCR_OCR_BATCH_SIZE=8
OCR_MAX_IMAGE_DIMENSION=6000
# One uvicorn worker per replica: each worker loads its own copy of every
# model. Scale with replicas, not workers.
WEB_CONCURRENCY=1
OMP_NUM_THREADS=2

# --- Uploads --------------------------------------------------------------
OCR_MAX_UPLOAD_SIZE_MB=50

# --- CORS -----------------------------------------------------------------
# Only when the frontend is hosted separately from the API (e.g. Vercel).
# Empty = same-origin only, which is the default single-container setup.
OCR_CORS_ALLOW_ORIGINS=
